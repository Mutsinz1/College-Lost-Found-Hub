# Database Configuration
DATABASE_URL=postgres://lostfound_user:lostfound_password@localhost:5432/lostfound?sslmode=disable

# Server Configuration
PORT=8080
ENVIRONMENT=development
HOST=localhost

# Comma-separated list of origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# Authentication (Google Sign-In)
# Create an OAuth client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Restrict sign-in to one email domain (e.g. your school); empty allows any
ALLOWED_EMAIL_DOMAIN=
# Also set the same client ID for the frontend in frontend/.env:
# REACT_APP_GOOGLE_CLIENT_ID=<your client id>.apps.googleusercontent.com

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@lostfound.com

# Required by docker-compose.prod.yml
POSTGRES_DB=lostfound
POSTGRES_USER=lostfound_user
POSTGRES_PASSWORD=
HTTP_PORT=80

# Rate limits: requests per client IP per hour on the endpoints that accept
# unauthenticated writes. Set a value to 0 to disable that limit.
# Raise these if you run integration tests repeatedly against one server.
RATE_LIMIT_POSTS_PER_HOUR=20
RATE_LIMIT_REPORTS_PER_HOUR=30
RATE_LIMIT_ALERTS_PER_HOUR=10
RATE_LIMIT_LOGINS_PER_HOUR=60
